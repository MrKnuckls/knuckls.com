<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="720" viewBox="0 0 1280 720">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3a1a1a;stop-opacity:0.3"/>
      <stop offset="100%" style="stop-color:#000;stop-opacity:0.8"/>
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#ef5350" stroke-opacity="0.08" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="1280" height="720" fill="#3a1a1a"/>
  <rect width="1280" height="720" fill="url(#grid)"/>
  <text x="640" y="340" text-anchor="middle" font-family="Arial" font-size="120" fill="#ef5350" opacity="0.15">🧟</text>
  <text x="640" y="440" text-anchor="middle" font-family="Arial" font-size="28" fill="#ef5350" opacity="0.5">DAYZ SS 1</text>
</svg>