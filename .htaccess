RewriteEngine On
RewriteBase /

# Force index.html as the default document
DirectoryIndex index.html

# Allow PHP scripts (server status ping, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.php$ - [L]

# Block any old WordPress paths from being accessed
RewriteRule ^wp-(admin|includes|content) / [R=301,L]

# Block index.php unless it's a real file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^index\.php$ / [R=301,L]

# Security headers to disable caching of HTML
<IfModule mod_headers.c>
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
</IfModule>

# Cache static assets for a year
<FilesMatch "\.(png|jpg|jpeg|gif|ico|svg|css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>